  "resolutionsRationale": {
    "postcss": "GHSA advisories cover postcss <=8.5.22; @expo/metro-config declares ~8.4.32 and no 8.4.x is patched, so this is a deliberate override and yarn's incompatibility warning is expected.",
    "uuid": "xcode@3.0.1 declares ^7.0.3, a line npm marks unsupported. It calls only uuid.v4(), which v11 still exports, so this is a deliberate override and yarn's incompatibility warning is expected.",
    "undici": "Advisory <6.28.0. 6.28.0 is the newest release inside @expo/cli's ^6.18.2, so the override stays in range.",
    "tar": "Advisory <=7.5.20. 7.5.22 is inside @expo/cli's ^7.5.2.",
    "**/@eslint/eslintrc/js-yaml": "Advisory >=4.0.0 <4.3.1. 4.3.2 is inside @eslint/eslintrc's ^4.1.1.",
    "**/@expo/xcpretty/js-yaml": "Advisory >=4.0.0 <4.3.1. 4.3.2 is inside @expo/xcpretty's ^4.1.0.",
    "**/@istanbuljs/load-nyc-config/js-yaml": "Advisory >=3.0.0 <3.15.1. 3.15.2 is inside @istanbuljs/load-nyc-config's ^3.13.1.",
    "shell-quote": "Kept above the <1.7.3 command-injection advisory; inside react-devtools-core's ^1.6.1."
  },
