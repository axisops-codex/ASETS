# Frontend env — copy to frontend/.env for local development.
# Only EXPO_PUBLIC_* vars are readable from app code, and they are BAKED INTO
# THE BUNDLE at build time — never put a secret here.
#
# Local API (simulator):        http://localhost:8000
# Local API (physical device):  http://<your-LAN-IP>:8000
# Production:                   set per profile in eas.json
EXPO_PUBLIC_BACKEND_URL=http://localhost:8000
