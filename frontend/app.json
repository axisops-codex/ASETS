{
  "expo": {
    "name": "ASETS",
    "slug": "asets",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "asets",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "primaryColor": "#3E6FA8",
    "backgroundColor": "#F6F9FC",
    "description": "Invoices, expenses and a live Self Assessment estimate for self-employed practitioners — designed to stay calm and simple for ADHD brains.",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.axisbsolutions.asets",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "ASETS uses the camera so you can photograph a receipt and turn it into an expense.",
        "NSPhotoLibraryUsageDescription": "ASETS attaches photos from your library to an expense as proof of purchase.",
        "NSFaceIDUsageDescription": "ASETS uses Face ID to unlock your financial data."
      }
    },
    "android": {
      "package": "com.axisbsolutions.asets",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/images/splash-image.png",
            "backgroundColor": "#0E1622"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "ASETS attaches photos from your library to an expense as proof of purchase.",
          "cameraPermission": "ASETS uses the camera so you can photograph a receipt and turn it into an expense."
        }
      ],
      [
        "expo-local-authentication",
        { "faceIDPermission": "ASETS uses Face ID to unlock your financial data." }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
