{
  "expo": {
    "name": "ASETS",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.freelancefinance.rrbth8",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan receipts to log your expenses",
        "NSPhotoLibraryUsageDescription": "Attach receipt photos to expenses",
        "NSFaceIDUsageDescription": "Unlock PsyBooks with Face ID"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.freelancefinance.rrbth8",
      "permissions": ["CAMERA", "USE_BIOMETRIC", "USE_FINGERPRINT"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach receipt photos to expenses",
          "cameraPermission": "Scan receipts to log your expenses"
        }
      ],
      [
        "expo-local-authentication",
        { "faceIDPermission": "Unlock PsyBooks with Face ID" }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
