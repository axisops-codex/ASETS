# ---------------------------------------------------------------------------
# ASETS API — copy to backend/.env, or generate one with:
#     python3 scripts/gen_secrets.py
# In production these come from GCP Secret Manager, not from a file.
# ---------------------------------------------------------------------------

# --- Database (required) ---------------------------------------------------
# Local:      postgresql://asets_app:PASSWORD@127.0.0.1:5432/asets
# Cloud SQL:  postgresql://asets_app:PASSWORD@/asets?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=postgresql://asets_app:changeme@127.0.0.1:5432/asets
DB_POOL_MAX=10

# Used only by the deploy job (db.deploy): the administrator connection
# that may CREATE EXTENSION, plus the password to set on the app role.
MIGRATION_DATABASE_URL=
DB_APP_PASSWORD=

# --- Secrets (required) ----------------------------------------------------
# python3 -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
# Encrypts HMRC tokens and NI numbers at rest. Rotating it forces every
# user to reconnect to HMRC.
# python3 -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- CORS ------------------------------------------------------------------
# Native app builds send no Origin header, so this only affects the web build.
CORS_ORIGINS=*

# --- Receipt storage -------------------------------------------------------
# local    = a mounted disk (a Cloud Storage bucket on Cloud Run)
# emergent = Emergent platform object storage (requires EMERGENT_LLM_KEY)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=/data/receipts

# --- Receipt scanning (optional; the app degrades to manual entry) ---------
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
RECEIPT_MODEL=claude-opus-5

# --- Companies House lookup (optional, free key) ---------------------------
COMPANIES_HOUSE_API_KEY=
COMPANIES_HOUSE_BASE_URL=https://api.company-information.service.gov.uk

# --- HMRC Making Tax Digital for Income Tax --------------------------------
# Register at developer.service.hmrc.gov.uk and subscribe the application to
# Business Details, Obligations, Self Employment Business and Individual
# Calculations. Sandbox credentials are issued immediately; production
# credentials need HMRC's approval.
HMRC_ENVIRONMENT=sandbox
HMRC_CLIENT_ID=
HMRC_CLIENT_SECRET=
# Must match exactly what is registered on the Developer Hub.
HMRC_REDIRECT_URI=http://localhost:8080/api/hmrc/callback
# Deep link the callback bounces back to.
HMRC_APP_RETURN_URL=asets://hmrc
HMRC_PRODUCT_NAME=ASETS
HMRC_SERVER_VERSION=1.0.0
# The API's own outbound public IP, sent as Gov-Vendor-Public-IP. Needs a
# static egress IP in production — see docs/HMRC.md.
HMRC_VENDOR_PUBLIC_IP=

# --- Emergent platform only ------------------------------------------------
EMERGENT_LLM_KEY=
EMERGENT_EMAIL_KEY=
INTEGRATION_PROXY_URL=
